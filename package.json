{
  "name": "@envarai/connect",
  "version": "2026.1126.1",
  "description": "Connect your own Agent to Envar: tasks, native adapters and recovery",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/native-a2a": {
      "types": "./dist/adapters/native-a2a.d.ts",
      "import": "./dist/adapters/native-a2a.js"
    },
    "./connector/loop": {
      "types": "./dist/connector/loop.d.ts",
      "import": "./dist/connector/loop.js"
    },
    "./connector/state": {
      "types": "./dist/connector/state.d.ts",
      "import": "./dist/connector/state.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./contracts/agent-task/v2/schema.json": "./contracts/agent-task/v2/schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "contracts",
    "README.md",
    "LICENSE",
    "docs",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnvarAI/EnvarConnect.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "node scripts/generate-task-contract.mjs --check && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "npm run format:check && npm run build && node --test test/*.test.mjs scripts/release.test.mjs",
    "prepack": "npm run build",
    "version:date": "node scripts/release-version.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@a2a-js/sdk": "1.2.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0",
    "json5": "2.2.3",
    "ws": "^8.23.0",
    "yaml": "2.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9.3",
    "prettier": "3.8.3"
  },
  "bin": {
    "envar-connect": "dist/cli.js"
  },
  "bundleDependencies": [
    "@a2a-js/sdk",
    "@modelcontextprotocol/sdk",
    "ajv",
    "ajv-formats",
    "canonicalize",
    "json5",
    "yaml",
    "zod",
    "ws"
  ],
  "homepage": "https://github.com/EnvarAI/EnvarConnect#readme",
  "keywords": [
    "ai-agents",
    "a2a",
    "mcp",
    "agent-task",
    "hermes",
    "openclaw",
    "typescript"
  ]
}
